package tls

use core {*}

#local PUMP_TRIES :: 64
#local PUMP_CHUNK :: 16384

// A connected TLS socket. The first field is an `io.Stream`, so `&Client`
// can be passed to `io.Reader`, `io.Writer`, and `io.Stream` procedures.
Client :: struct {
    use stream: io.Stream

    sock: net.Socket
    ctx: Ctx
    ssl: Ssl
    rbio: Bio
    wbio: Bio
    alive: bool
}

#overload
__dispose_used_local :: macro (c: &Client) {
    #this_package.Client.close(c)
}

// Ciphertext sits in the write BIO until it is copied onto the TCP socket.
#local
flush_out :: (sock: &net.Socket, wbio: Bio) -> bool {
    buf: [PUMP_CHUNK] u8
    while true {
        n := BIO_read(wbio, &buf[0], PUMP_CHUNK)
        if n <= 0 do return true
        sock->sendall(buf[0 .. n])
        if !sock->is_alive() do return false
    }
    return true
}

#local
fill_in :: (sock: &net.Socket, rbio: Bio) -> bool {
    buf: [PUMP_CHUNK] u8
    n := sock->recv_into(buf[0 .. PUMP_CHUNK])
    if n <= 0 do return false
    return BIO_write(rbio, &buf[0], n) > 0
}

#local
release :: (sock: &net.Socket, ctx: Ctx, ssl: Ssl, rbio: Bio, wbio: Bio, bios_owned_by_ssl: bool) {
    if bios_owned_by_ssl {
        if ~~ssl != null do SSL_free(ssl)
    } else {
        if ~~ssl != null do SSL_free(ssl)
        if ~~rbio != null do BIO_free(rbio)
        if ~~wbio != null do BIO_free(wbio)
    }
    if ~~ctx != null do SSL_CTX_free(ctx)
    sock->close()
}

// Directory stores are not in this build. A PEM bundle is loaded from memory.
#local
load_ca_pem :: (ctx: Ctx, pem: str) -> bool {
    if pem.count == 0 do return true

    bio := BIO_new_mem_buf(pem.data, cast(i32) pem.count)
    if ~~bio == null do return false

    store := SSL_CTX_get_cert_store(ctx)
    loaded := 0
    while true {
        cert := PEM_read_bio_X509(bio, null, null, null)
        if ~~cert == null do break
        added := X509_STORE_add_cert(store, cert) == 1
        X509_free(cert)
        if !added {
            BIO_free(bio)
            return false
        }
        loaded += 1
    }
    BIO_free(bio)
    ERR_clear_error()
    return loaded > 0
}

#local
stream_write :: (c: &Client, data: [] u8) -> Result(u32, io.Error) {
    if !c.alive || ~~c.ssl == null do return .{ Err = .EOF }
    if data.count == 0 do return .{ Ok = 0 }

    off := 0
    tries := 0
    while off < data.count && tries < PUMP_TRIES {
        tries += 1
        ptr := cast(rawptr) (cast([&] u8) data.data + off)
        rc := SSL_write(c.ssl, ptr, cast(i32) (data.count - off))
        if !flush_out(&c.sock, c.wbio) {
            c.alive = false
            if off > 0 do return .{ Ok = cast(u32) off }
            return .{ Err = .EOF }
        }
        if rc > 0 {
            off += rc
            continue
        }

        err := SSL_get_error(c.ssl, rc)
        if err == SSL_ERROR_WANT_READ {
            if !fill_in(&c.sock, c.rbio) {
                c.alive = false
                if off > 0 do return .{ Ok = cast(u32) off }
                return .{ Err = .EOF }
            }
            continue
        }
        if err == SSL_ERROR_WANT_WRITE do continue
        if off > 0 do return .{ Ok = cast(u32) off }
        return .{ Err = .OperationFailed }
    }

    if off == 0 do return .{ Err = .NoProgress }
    return .{ Ok = cast(u32) off }
}

#local
stream_write_byte :: (c: &Client, byte: u8) -> io.Error {
    b: [1] u8
    b[0] = byte
    if err := stream_write(c, b).Err ?? io.Error.None; err != .None {
        return err
    }
    return .None
}

Client.close :: (c: &Client) {
    if ~~c.ssl != null {
        // Send our close notify. Do not wait for the peer's; some hosts
        // advertise Connection: close and then leave the TCP socket open.
        SSL_shutdown(c.ssl)
        flush_out(&c.sock, c.wbio)
        SSL_free(c.ssl)
    }
    if ~~c.ctx != null do SSL_CTX_free(c.ctx)
    c.ssl = cast(Ssl) null
    c.ctx = cast(Ctx) null
    c.rbio = cast(Bio) null
    c.wbio = cast(Bio) null
    c.vtable = null
    if c.alive {
        c.sock->close()
        c.alive = false
    }
}

#local
client_vtable := io.Stream_Vtable.{
    read = (use c: &Client, buffer: [] u8) -> Result(u32, io.Error) {
        if !alive || ~~ssl == null do return .{ Err = .EOF }
        if buffer.count <= 0 do return .{ Ok = 0 }

        tries := 0
        while tries < PUMP_TRIES {
            tries += 1
            rc := SSL_read(ssl, buffer.data, cast(i32) buffer.count)
            if !flush_out(&sock, wbio) {
                alive = false
                return .{ Err = .EOF }
            }
            if rc > 0 do return .{ Ok = cast(u32) rc }

            err := SSL_get_error(ssl, rc)
            if err == SSL_ERROR_ZERO_RETURN do return .{ Err = .EOF }
            if err == SSL_ERROR_WANT_READ {
                if !fill_in(&sock, rbio) {
                    alive = false
                    return .{ Err = .EOF }
                }
                continue
            }
            if err == SSL_ERROR_WANT_WRITE do continue
            return .{ Err = .OperationFailed }
        }
        return .{ Err = .NoProgress }
    },

    write = (c: &Client, data: [] u8) -> Result(u32, io.Error) {
        return stream_write(c, data)
    },

    write_byte = stream_write_byte,

    flush = (use c: &Client) -> io.Error {
        if !alive do return .EOF
        if !flush_out(&sock, wbio) {
            alive = false
            return .EOF
        }
        return .None
    },

    poll = (use c: &Client, ev: io.PollEvent, timeout: i32) -> Result(bool, io.Error) {
        if ev == .Write do return .{ Ok = alive }
        if !alive || ~~ssl == null do return .{ Ok = false }

        // Plaintext already decrypted, or ciphertext waiting in the read BIO.
        if SSL_pending(ssl) > 0 do return .{ Ok = true }
        if BIO_ctrl(rbio, BIO_CTRL_PENDING, 0, null) > 0 do return .{ Ok = true }

        status := sock->poll(timeout)
        if status == .Closed do return .{ Err = .EOF }
        return .{ Ok = status == .Readable }
    },

    close = (use c: &Client) -> io.Error {
        Client.close(c)
        return .None
    },
}

Client.connect :: (host: str, port: u16, ca_pem: str = "") -> Result(Client, io.Error) {
    sock: net.Socket
    switch net.dial(host, port, .Stream) {
        case .Ok as opened { sock = opened }
        case .Err as err   { return .{ Err = err } }
    }

    method := TLS_client_method()
    ctx := SSL_CTX_new(method)
    ssl := SSL_new(ctx)
    rbio := BIO_new(BIO_s_mem())
    wbio := BIO_new(BIO_s_mem())
    if ~~ctx == null || ~~ssl == null || ~~rbio == null || ~~wbio == null {
        release(&sock, ctx, ssl, rbio, wbio, false)
        return .{ Err = .CreationFailed }
    }

    if ca_pem.count == 0 {
        SSL_CTX_set_verify(ctx, SSL_VERIFY_NONE, null)
    } else {
        SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, null)
        if !load_ca_pem(ctx, ca_pem) {
            release(&sock, ctx, ssl, rbio, wbio, false)
            return .{ Err = .CreationFailed }
        }
    }

    SSL_ctrl(ssl, SSL_CTRL_SET_TLSEXT_HOSTNAME, 0, host->to_cstr_on_stack())
    SSL_set_bio(ssl, rbio, wbio)
    BIO_ctrl(rbio, BIO_C_SET_BUF_MEM_EOF_RETURN, -1, null)
    BIO_ctrl(wbio, BIO_C_SET_BUF_MEM_EOF_RETURN, -1, null)

    tries := 0
    while tries < PUMP_TRIES {
        tries += 1
        rc := SSL_connect(ssl)
        if !flush_out(&sock, wbio) {
            release(&sock, ctx, ssl, rbio, wbio, true)
            return .{ Err = .ConnectFailed }
        }
        if rc == 1 {
            return .{ Ok = .{
                stream = .{
                    vtable = &client_vtable,
                    flags  = .Block_On_Read,
                },
                sock  = sock,
                ctx   = ctx,
                ssl   = ssl,
                rbio  = rbio,
                wbio  = wbio,
                alive = true,
            } }
        }

        err := SSL_get_error(ssl, rc)
        if err == SSL_ERROR_WANT_READ {
            if !fill_in(&sock, rbio) {
                release(&sock, ctx, ssl, rbio, wbio, true)
                return .{ Err = .ConnectFailed }
            }
            continue
        }
        if err == SSL_ERROR_WANT_WRITE do continue

        release(&sock, ctx, ssl, rbio, wbio, true)
        return .{ Err = .ConnectFailed }
    }

    release(&sock, ctx, ssl, rbio, wbio, true)
    return .{ Err = .ConnectFailed }
}

// Prints the OpenSSL error queue. The strings point at a stack buffer, so
// this prints them before returning.
openssl_print_errors :: () {
    while true {
        err := ERR_get_error()
        if err == 0 do return
        buf: [256] u8
        ERR_error_string_n(err, &buf[0], 256)
        printf("ssl: {}\n", string.from_cstr(&buf[0]))
    }
}
